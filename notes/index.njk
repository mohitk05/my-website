<h1>Notes</h1>
<p>My notes are extensions of my thought - I write when I learn something new, or when I think.</p>
<hr/>
<div>
<div class="grid">
    {%- for post in collections.notes | reverse -%}
        <div style="margin-bottom: 10px">
            <h4>
                {%if post.data.external %}
                    <a href="{{ post.data.external }}">{{ post.data.title }}</a>
                {% else %}
                    <a href="{{ post.url }}">{{ post.data.title }}</a>
                {% endif %}
                
            </h4>
        </div>
    {%- endfor -%}
</div>
</div>
