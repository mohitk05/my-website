{#
  OG image design template.

  Rendered via Nunjucks at build time (see `_og-image/generate.js`), then
  fed into satori to produce an SVG, which is rasterized to PNG by
  @resvg/resvg-js. Keep in mind satori only supports a limited subset of
  HTML/CSS:
    - Use flexbox for layout (display:flex everywhere; no block/grid).
    - Use inline `style="..."` attributes, not classes or <style> blocks.
    - Only TTF/OTF/WOFF fonts are supported (see fonts/ dir), no CSS
      @font-face or system font stacks.

  Available variables: title, date, fontSize
#}
<div style="width:{{ width }}px;height:{{ height }}px;position:relative;display:flex;background:#efefef;font-family:Inter;border:10px solid #a82b23;">
  <div style="position:absolute;top:0;left:0;width:100%;height:100%;display:flex;background-image:radial-gradient(circle 3px,rgba(0,0,0,0.06) 100%,transparent 100%);background-size:28px 28px;border-radius:20px;"></div>
  <div style="position:relative;width:100%;height:100%;display:flex;flex-direction:column;justify-content:space-between;padding:80px;color:#1d1d1d;">
    <div style="font-size:28px;opacity:0.85;color:#a82b23">mohitkarekar.com</div>
    <div style="font-size:{{ fontSize }}px;font-weight:700;line-height:1.0;font-style:italic;">{{ title }}</div>
    <div style="font-size:28px;opacity:0.85;display:flex;justify-content:flex-start;">{{ date }}</div>
  </div>
</div>
