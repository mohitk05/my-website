<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {% if tags %}
    <meta name="keywords" content="{{ tags.join(',') }}" />
    {% endif %}
    <meta name="author" content="Mohit Karekar" />
    <meta
      property="description"
      {% if page.excerpt|length %}
      content="{{ page.excerpt }}"
      {% elif description|length %}
      content="{{ description }}"
      {% else %}
      content="Hello! I am Mohit Karekar. Watch my work and read blog posts I occassionaly write. I am a software engineer and a curious reader. I currently work on the web platform at Zalando in Berlin, Germany."
      {% endif %}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content="mohitkarekar.com" />
    <meta name="twitter:creator" content="@MohitKarekar" />
    <meta
      property="twitter:title"
      content="{{ title if title else 'Mohit Karekar - Software Engineer' }}"
    />
    <meta property="og:site_name" content="mohitkarekar.com" />
    <meta
      property="og:title"
      content="{{ title if title else 'Mohit Karekar - Software Engineer' }}"
    />
    <meta
      property="og:url"
      content="{{ 'https://mohitkarekar.com' + page.url if page and page.url else 'https://mohitkarekar.com' }}"
    />
    <meta
      property="og:description"
      {% if page.excerpt|length %}
      content="{{ page.excerpt }}"
      {% elif description|length %}
      content="{{ description }}"
      {% else %}
      content="Hello! I am Mohit Karekar. Watch my work and read blog posts I occassionaly write. I am a software engineer and a curious reader. I currently work on the web platform at Zalando in Berlin, Germany."
      {% endif %}
    />
    {% if coverImage and 'http' in coverImage %}
    <meta
      property="og:image"
      content="{{ coverImage if coverImage else '/mohit.jpg' }}"
    />
    <link
      rel="preload"
      href="{{ coverImage if coverImage else '/mohit.jpg' }}"
      as="image"
    />
    {% else %}
    <meta
      property="og:image"
      content="{{ 'https://mohitkarekar.com' + coverImage if coverImage else 'https://mohitkarekar.com/img/meta-cover.png' }}"
    />
    {# {% ogImage "./_includes/og-image.og.njk", { title: "Hello World!" } %} #}
    <link
      rel="preload"
      href="{{ 'https://mohitkarekar.com' + coverImage if coverImage else 'https://mohitkarekar.com/img/mk_profile.webp' }}"
      as="image"
    />
    {% endif %}
    <meta property="og:type" content="article" />
    <meta property="article:author" content="https://mohitkarekar.com/about" />
    <link rel="canonical" href="{{ 'https://mohitkarekar.com' + page.url }}" />

    {# Structured Data - Person Schema for Homepage #}
    {% if page.url == '/' %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Mohit Karekar",
      "url": "https://mohitkarekar.com",
      "image": "https://mohitkarekar.com/img/mk_profile.webp",
      "jobTitle": "Principal Engineer",
      "worksFor": {
        "@type": "Organization",
        "name": "Zalando"
      },
      "sameAs": [
        "https://github.com/mohitk05",
        "https://twitter.com/mohitkarekar",
        "https://www.linkedin.com/in/mohit-karekar/"
      ],
      "knowsAbout": ["Web Platform", "Systems Programming", "Compilers", "Software Engineering"]
    }
    </script>
    {% endif %}

    {# Structured Data - BlogPosting Schema for Blog Posts #}
    {% if tags and 'posts' in tags %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": "{{ title }}",
      "author": {
        "@type": "Person",
        "name": "Mohit Karekar",
        "url": "https://mohitkarekar.com"
      },
      "datePublished": "{{ date | dateISO }}",
      "dateModified": "{{ date | dateISO }}",
      "description": "{% if page.excerpt %}{{ page.excerpt }}{% elif description %}{{ description }}{% endif %}",
      "url": "{{ 'https://mohitkarekar.com' + page.url }}",
      {% if coverImage %}
      "image": "{% if 'http' in coverImage %}{{ coverImage }}{% else %}{{ 'https://mohitkarekar.com' + coverImage }}{% endif %}",
      {% endif %}
      "publisher": {
        "@type": "Person",
        "name": "Mohit Karekar",
        "logo": {
          "@type": "ImageObject",
          "url": "https://mohitkarekar.com/img/mk_profile.webp"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ 'https://mohitkarekar.com' + page.url }}"
      }
    }
    </script>
    {% endif %}

    <link rel="stylesheet" href="/css/water.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
    {% if page.url == '/' %} {%- for post in collections.posts | reverse |
    slice10 -%}
    <link rel="prefetch" href="{{ post.url }}" as="document" />
    {%- endfor -%} {%- endif -%}
    <link rel="icon" href="/img/icon.jpg" />
    <title>{{ title }}</title>
    <style>
      table {
        width: 100%
      }

      body {
        font-family: 'Inter', sans-serif;
        font-size: 1.125rem;
        max-width: 800px;
        font-optical-sizing: auto;
        line-height: 1.625;
      }

      td {
        word-break: keep-all
      }

      @media only screen and (max-width: 600px) {
        body {
          padding: 1rem
        }

        h1 {
          font-size: 2.2rem
        }
      }

      h1,
      h2,
      h3,
      h4 {
        {# font-family: 'Source Sans 3', sans-serif; #}
        font-family: 'Inter Tight', sans-serif;
        font-weight: 600;
        font-style: normal;
      }
      pre {
        box-shadow: 0px 2px 0 0 rgba(0, 0, 0, 0.1);
      }
      code {
        {# font-size: 1rem; #}
        box-shadow: 0px 2px 0 0 rgba(0, 0, 0, 0.1);
      }
      pre code {
        box-shadow: none;
      }

      article pre[class*="language-"] {
        padding: 4px
      }

      .page {
        padding: 35px;
        position: relative;
      }

      @media only screen and (max-width: 640px) {
        body {
          margin: 0;
        }

        .page {
          padding: 0;
          filter: none;
        }
      }
    </style>
  </head>

  <body>
    <div class="container main page">
      {{ content | safe }}
      <div style="display: flex; justify-content: center; align-items: center; margin-top: 20px; font-size: 1rem">
        <span>© Mohit Karekar</span>
        <span style="margin: 0 10px;">•</span>
        <a href="mailto:karekar.mohit@gmail.com">karekar.mohit@gmail.com</a>
        <span style="margin: 0 10px;">•</span>
        <div style="display: flex">
          <a target="_blank" href="https://github.com/mohitk05" rel="me"
            ><img
              class="socialIcon"
              alt="github"
              style="width: 1rem; height: auto"
              src="/img/github.png"
          /></a>
          <a target="_blank" href="https://twitter.com/mohitkarekar"
            ><img
              class="socialIcon"
              alt="twitter"
              style="width: 1rem; height: auto; margin-left: 10px"
              src="/img/twitter.png"
          /></a>
          <a target="_blank" href="https://www.linkedin.com/in/mohit-karekar/"
            ><img
              class="socialIcon"
              alt="linkedin"
              style="width: 1rem; height: auto; margin-left: 10px"
              src="/img/linkedin.png"
          /></a>
        </div>
      </div>
      
    </div>

    <script>
      console.log(
        "Hello there! Welcome to our friendly abode, the console. Do you have a dev question? Or do you want to have a chat?\nIn any case, drop a mail to karekar.mohit@gmail.com ❤️"
      );
    </script>
    <script>
      function onMermaidLoad() {
        mermaid.initialize({
          theme: (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark': 'default',
          themeVariables: {
            fontFamily: 'Source Code Pro, Menlo, monospace',
          }
        })
      }
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/mermaid@11.6.0/dist/mermaid.min.js';
      script.onload = onMermaidLoad;
      script.async = true;
      document.head.appendChild(script);
    </script>
  </body>
</html>
